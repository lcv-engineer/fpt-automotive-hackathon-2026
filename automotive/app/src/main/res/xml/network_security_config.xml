<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dev ASR only. Non-loopback / production deployments must use HTTPS.

         - 127.0.0.1 / localhost: physical device + `adb reverse`
         - 10.0.2.2: emulator → host loopback (no reverse needed each boot)

         includeSubdomains="false" is required (NetworkSecurityConfig lint) and correct
         for these hosts (no meaningful subdomains). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
