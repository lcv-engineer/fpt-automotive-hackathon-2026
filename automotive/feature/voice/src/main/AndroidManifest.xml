<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application>
        <service
            android:name=".via.VivaVoiceInteractionService"
            android:exported="true"
            android:label="@string/voice_assistant_label"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".via.VivaVoiceInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <service
            android:name=".via.VivaRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <activity
            android:name=".via.VoiceAssistantSettingsActivity"
            android:exported="true"
            android:label="@string/voice_assistant_settings_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- exported for adb/emulator bring-up; no intent-filter, so not launcher-discoverable. -->
        <activity
            android:name=".via.HotwordEnrollmentActivity"
            android:exported="true"
            android:label="@string/hotword_enroll_title"
            android:theme="@android:style/Theme.DeviceDefault.DayNight">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
