<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application>
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.sopa.viva_automotive.feature.media.cast.VivaCastOptionsProvider" />

        <!-- Trỏ tới automotive_app_desc.xml: đây là thứ khiến AAOS xếp app vào
             nhóm nguồn nhạc và hiện nó trong media switcher của xe. -->
        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <!-- label là tên mà trình chuyển nguồn nhạc của xe hiển thị cho service
             này; không đặt icon riêng để xe dùng luôn icon của app. -->
        <service
            android:name=".service.VivaMediaBrowserService"
            android:exported="true"
            android:label="@string/media_browser_service_label">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Readable by Car Media / cluster for album art (iconUri / artworkUri). -->
        <provider
            android:name=".data.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
