# viva-asr configuration. Copy to .env for local runs; in the container these
# are set by the Dockerfile / CarSky node config. Keep the real API key only in
# an untracked `.env` or the container secret store, never in this file.

# CTranslate2 model directory (what ct2-transformers-converter writes), or a
# plain faster-whisper model id such as "tiny".
ASR_MODEL_PATH=/models/asr-ct2

# Reported verbatim by GET /health and quoted in the benchmark write-up, so
# keep it truthful when swapping models.
ASR_MODEL_NAME=phowhisper-tiny-int8

ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# 0 = let CTranslate2 pick based on the pod's CPU allocation.
ASR_CPU_THREADS=0
ASR_NUM_WORKERS=1

ASR_LANGUAGE=vi
# 1 = greedy. Beam search buys a little accuracy for latency the 1500 ms p95
# budget cannot spare; raise it only if benchmarks show headroom.
ASR_BEAM_SIZE=1

# 30 s of 16 kHz mono PCM16.
ASR_MAX_BODY_BYTES=960000
ASR_MIN_AUDIO_MS=200

# Optional VIVA Brain slow path. The endpoint returns 503 until a server-side
# key is configured. Never put this key in Gradle, BuildConfig, or the APK.
OPENAI_API_KEY=
VIVA_BRAIN_MODEL=gpt-5.4-mini-2026-03-17
