# Copy to .env and fill in. .env is git-ignored — never commit real values.

# CarSky platform API base URL.
# CONFIRMED 02/08/2026 by probing: this host serves the REST API — it answers
# /api/v1/* with structured JSON ({"error":"UNAUTHORIZED",...}), not the web
# UI's HTML. Auth scheme confirmed too: with no Authorization header the reply
# is "Missing credentials"; with one it becomes "Invalid JWT".
# Still UNVERIFIED: the individual endpoint paths, because the auth middleware
# runs BEFORE routing (a nonsense path also returns 401). Re-check them, and
# pull GET /api/v1/openapi, the first time a working token is available.
CARSKY_BASE_URL=https://hackathon-2.carsky.io/api/v1

# Personal API token, sent as "Authorization: Bearer <token>".
# Get this from your CarSky account — do not share it in chat/commits.
CARSKY_API_TOKEN=

# Default room/deployment id, used when --room is not passed explicitly to
# `viva-tools carsky nodes` / `viva-tools carsky adb-tunnel`.
CARSKY_ROOM_ID=

# Per-request HTTP timeout in seconds. Optional — defaults to 30 if unset.
# Raise this if the CarSky VM is slow to respond under load (cold container,
# VM restart in progress).
CARSKY_TIMEOUT_SECONDS=30
